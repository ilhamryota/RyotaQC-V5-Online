<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Twenty UI / Linear Solid Slate Palette -->
    <Color x:Key="AppBackgroundColor">#FF0B0F17</Color>
    <Color x:Key="SurfaceColor">#FF111827</Color>
    <Color x:Key="SurfaceAltColor">#FF161F30</Color>
    <Color x:Key="NeonBlueColor">#FF2563EB</Color>
    <Color x:Key="NeonBlueSoftColor">#FF3B82F6</Color>
    <Color x:Key="BorderColor">#FF1E293B</Color>
    <Color x:Key="TextPrimaryColor">#FFF8FAFC</Color>
    <Color x:Key="TextMutedColor">#FF94A3B8</Color>

    <!-- Twenty UI Extended Tokens -->
    <Color x:Key="Ps5AccentColor">#FF2563EB</Color>
    <Color x:Key="Ps5AccentBrightColor">#FF3B82F6</Color>
    <Color x:Key="Ps5WaveColor">#00000000</Color>
    <Color x:Key="Ps5WaveDeepColor">#00000000</Color>
    <Color x:Key="Ps5GlassColor">#FF111827</Color>
    <Color x:Key="Ps5CardBorderColor">#FF1E293B</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="NeonBlueBrush" Color="{StaticResource NeonBlueColor}" />
    <SolidColorBrush x:Key="NeonBlueSoftBrush" Color="{StaticResource NeonBlueSoftColor}" />
    <SolidColorBrush x:Key="BorderBrushNeon" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <SolidColorBrush x:Key="Ps5AccentBrush" Color="{StaticResource Ps5AccentColor}" />
    <SolidColorBrush x:Key="Ps5AccentBrightBrush" Color="{StaticResource Ps5AccentBrightColor}" />
    <SolidColorBrush x:Key="Ps5WaveBrush" Color="{StaticResource Ps5WaveColor}" />
    <SolidColorBrush x:Key="Ps5WaveDeepBrush" Color="{StaticResource Ps5WaveDeepColor}" />
    <SolidColorBrush x:Key="Ps5GlassBrush" Color="{StaticResource Ps5GlassColor}" />
    <SolidColorBrush x:Key="Ps5CardBorderBrush" Color="{StaticResource Ps5CardBorderColor}" />

    <LinearGradientBrush x:Key="Ps5WaveFillBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Ps5WaveFillBrushAlt" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Ps5AmbientGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#00000000" Offset="0" />
        <GradientStop Color="#00000000" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
