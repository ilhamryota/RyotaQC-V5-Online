<Window x:Class="RyotaQC.App.Views.Windows.QcErpSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hubungkan ke ERP"
        Width="650"
        SizeToContent="Height"
        MaxHeight="740"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Item template unit PO: tampilkan DisplayText (bukan nama tipe class) -->
        <DataTemplate x:Key="PoUnitItemTemplate">
            <TextBlock Text="{Binding DisplayText}"
                       Foreground="#E8EFFF"
                       FontSize="12.5"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DisplayText}" />
        </DataTemplate>

        <!-- Tombol hapus tester (icon sampah) -->
        <Style x:Key="TesterDeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Hapus tester ini dari database ERP" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                            <TextBlock x:Name="Glyph"
                                       Text="&#xE74D;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="#FF9B9B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FF6B6B" />
                                <Setter TargetName="Glyph" Property="Foreground" Value="#FFD2D2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item template tester: nama + icon sampah untuk hapus dari DB -->
        <DataTemplate x:Key="TesterItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Name}"
                           Foreground="#E8EFFF"
                           FontSize="12.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource TesterDeleteButtonStyle}"
                        Tag="{Binding}"
                        Click="DeleteTester_Click" />
            </Grid>
        </DataTemplate>

        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121E32" Offset="0" />
            <GradientStop Color="#0D1728" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9EACC1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#F4F7FF" />
            <Setter Property="CaretBrush" Value="#F4F7FF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#0B1322" />
            <Setter Property="BorderBrush" Value="#2C3F5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3488FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#F5F8FF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#202C40" BorderBrush="#34465F" BorderThickness="1" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A3B56" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4C8CE4" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SmallButtonStyle}">
            <Setter Property="Background" Value="#1B2940" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="18,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#1768E9" Offset="0" />
                                    <GradientStop Color="#398FFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#428FFF" />
                            </Border.BorderBrush>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A7B5CA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="12,9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C3E6C" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#398CFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#398CFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="MaxDropDownHeight" Value="210" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#F4F7FF" />
            <Setter Property="Background" Value="#0B1322" />
            <Setter Property="BorderBrush" Value="#2C3F5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                CornerRadius="10"
                                                Background="#0B1322"
                                                BorderBrush="#2C3F5E"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="30" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="12,0,0,0"
                                                                  VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  TextElement.Foreground="#F4F7FF"
                                                                  TextElement.FontSize="13"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="#8C97AB"
                                                      StrokeThickness="1.4"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#3488FF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#0B1322"
                                        BorderBrush="#2C3F5E"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E8EFFF" />
                        <Setter Property="Padding" Value="12,9" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1B3A66" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#344B6E"
            BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <!-- Soft top-right glow from the mockup. -->
            <Rectangle IsHitTestVisible="False" RadiusX="20" RadiusY="20">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.85" RadiusY="0.62">
                        <GradientStop Color="#331D3760" Offset="0" />
                        <GradientStop Color="#00121E32" Offset="1" />
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ===== Header ===== -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14" Background="#1A3D69" BorderBrush="#347FF0" BorderThickness="1">
                        <TextBlock Text="&#xE774;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="22"
                                   Foreground="#70B2FF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Hubungkan ke ERP"
                                   Foreground="#F4F7FF"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="21" />
                        <TextBlock Text="Pilih unit kanban dan tester sebelum mengisi Quality Control"
                                   Foreground="#91A1BA"
                                   FontSize="12"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="CloseButton"
                            Content="&#x2715;"
                            Click="Close_Click"
                            FontSize="18"
                            Width="35"
                            Height="35"
                            VerticalAlignment="Top"
                            Cursor="Hand"
                            Foreground="#A5B5CD"
                            Background="Transparent"
                            BorderThickness="0"
                            ToolTip="Tutup" />
                </Grid>

                <!-- ===== Already connected strip ===== -->
                <Border Grid.Row="1"
                        x:Name="ConnectedPanel"
                        Margin="0,18,0,0"
                        CornerRadius="11"
                        Background="#14291F"
                        BorderBrush="#2E7D4F"
                        BorderThickness="1"
                        Padding="14,12"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="SUDAH TERHUBUNG"
                                       FontFamily="Bahnschrift SemiBold"
                                       FontSize="10.5"
                                       Foreground="#4ADE80" />
                            <TextBlock x:Name="ConnectedText"
                                       FontSize="13"
                                       Foreground="#E8FFF2"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button x:Name="KeepButton"
                                    Content="Lanjutkan"
                                    Click="Keep_Click"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Height="34" />
                            <Button x:Name="ChangeButton"
                                    Content="Ganti"
                                    Click="Change_Click"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Height="34"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Mode selector ===== -->
                <Border Grid.Row="2"
                        x:Name="ModeSelector"
                        Margin="0,14,0,0"
                        Background="#0B1424"
                        BorderBrush="#243550"
                        BorderThickness="1"
                        CornerRadius="13"
                        Padding="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0"
                                     x:Name="ModePoRadio"
                                     GroupName="ErpMode"
                                     Content="Via No PO"
                                     Style="{StaticResource SegmentStyle}"
                                     IsChecked="True"
                                     Checked="ModePo_Checked" />
                        <RadioButton Grid.Column="1"
                                     x:Name="ModeUnitRadio"
                                     GroupName="ErpMode"
                                     Content="Via Kode Unit"
                                     Style="{StaticResource SegmentStyle}"
                                     Margin="8,0,0,0"
                                     Checked="ModeUnit_Checked" />
                    </Grid>
                </Border>

                <!-- ===== Mode panels ===== -->
                <Grid Grid.Row="3" Margin="0,14,0,0">

                    <!-- PO mode -->
                    <StackPanel x:Name="PoPanel" VerticalAlignment="Top">
                        <TextBlock Text="NOMOR PURCHASE ORDER" Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="PoBox"
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="Ketik No PO dari ERP (contoh: PO-0003)" />
                            <Button Grid.Column="1"
                                    x:Name="PoSearchButton"
                                    Content="Cari &#x2197;"
                                    Click="PoSearch_Click"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Width="88"
                                    Height="38"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="PILIH KODE UNIT" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6" />
                        <Grid>
                            <ComboBox x:Name="PoUnitCombo"
                                      Style="{StaticResource ComboStyle}"
                                      ItemTemplate="{StaticResource PoUnitItemTemplate}"
                                      ToolTip="Unit yang tersedia untuk No PO di atas" />
                            <TextBlock Text="Pilih Kode Unit"
                                       Foreground="#66748B"
                                       FontSize="12.5"
                                       Margin="13,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedItem, ElementName=PoUnitCombo}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Border CornerRadius="10" Background="#0B1424" BorderBrush="#253650" BorderThickness="1" Padding="11,8" Margin="0,10,0,0">
                            <TextBlock x:Name="PoStatusText"
                                       Foreground="#91A0B8"
                                       FontSize="11.5"
                                       TextWrapping="Wrap"
                                       MaxHeight="44"
                                       Text="Masukkan nomor PO, lalu klik Cari untuk memilih unit." />
                        </Border>
                    </StackPanel>

                    <!-- Unit mode -->
                    <StackPanel x:Name="UnitPanel" VerticalAlignment="Top" Visibility="Collapsed">
                        <TextBlock Text="KODE UNIT" Style="{StaticResource FieldLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="UnitCodeBox"
                                     Style="{StaticResource InputStyle}"
                                     ToolTip="Kode unit / Pra-QC code / serial (contoh: EST-2610-0003-01)" />
                            <Button Grid.Column="1"
                                    x:Name="UnitSearchButton"
                                    Content="Cari &#x2197;"
                                    Click="UnitSearch_Click"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Width="88"
                                    Height="38"
                                    Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="DETAIL UNIT" Style="{StaticResource FieldLabelStyle}" Margin="0,12,0,6" />
                        <Border CornerRadius="10" Background="#0B1424" BorderBrush="#253650" BorderThickness="1" Padding="11,8" Height="104">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="UnitDetailText"
                                           Foreground="#D5DCE8"
                                           FontFamily="Consolas"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Text="Belum ada unit yang dicari." />
                            </ScrollViewer>
                        </Border>

                        <TextBlock x:Name="UnitStatusText"
                                   Foreground="#91A0B8"
                                   FontSize="11.5"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ===== Connect ===== -->
                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                    <Button x:Name="ConnectButton"
                            Content="&#x2197;   Hubungkan ke ERP"
                            Click="Connect_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False" />
                    <TextBlock x:Name="FooterStatusText"
                               Foreground="#8293AD"
                               FontSize="11.5"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,7,0,0"
                               Text="Pilih kode unit dan tester terlebih dahulu." />
                </StackPanel>

                <!-- ===== Footer: tester + new tester + without ERP ===== -->
                <Border Grid.Row="5"
                        Margin="0,12,0,0"
                        Padding="0,12,0,0"
                        BorderBrush="#293951"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Tester (wajib)"
                                       Foreground="#8E9DB5"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <Grid Grid.Column="1">
                                <ComboBox x:Name="TesterCombo"
                                          Style="{StaticResource ComboStyle}"
                                          Height="36"
                                          ItemTemplate="{StaticResource TesterItemTemplate}"
                                          ToolTip="Tester QC yang terdaftar di ERP / Hub" />
                                <TextBlock Text="Pilih Tester"
                                           Foreground="#66748B"
                                           FontSize="12.5"
                                           Margin="13,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem, ElementName=TesterCombo}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>

                        <TextBlock Text="DAFTAR TESTER BARU"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,10,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     x:Name="NewTesterBox"
                                     Style="{StaticResource InputStyle}"
                                     Height="36"
                                     FontSize="12.5"
                                     ToolTip="Ketik nama tester baru lalu klik Add New Tester" />
                            <Button Grid.Column="1"
                                    x:Name="AddTesterButton"
                                    Content="Add New Tester"
                                    Click="AddTester_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="150"
                                    Height="36"
                                    Margin="8,0,0,0"
                                    ToolTip="Daftarkan tester baru ke database ERP" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Button x:Name="SkipButton"
                                    Content="Tanpa ERP"
                                    Click="Skip_Click"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="150"
                                    Height="36"
                                    HorizontalAlignment="Right"
                                    ToolTip="Masuk ke Quality Control tanpa menghubungkan ke kanban ERP" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
