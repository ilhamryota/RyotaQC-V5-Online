<Window x:Class="RyotaQC.App.Views.Windows.QcErpSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EsteraOne ERP Sync"
        Width="760"
        Height="560"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1425"
        AllowsTransparency="True"
        ShowInTaskbar="False">
    <Border CornerRadius="16" Background="#F20F1425" BorderBrush="#556FA7FF" BorderThickness="1.5" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="12" Background="#33263A5E" BorderBrush="#554CA7FF" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="&#xE774;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="#4CA7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ESTERAONE ERP SYNC"
                               Foreground="#F6F8FF"
                               FontFamily="Bahnschrift Bold"
                               FontSize="20" />
                    <TextBlock Text="Hubungkan kode unit kanban ERP sebelum memulai Quality Control"
                               Foreground="#8C97AB"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Two columns -->
            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- COLUMN 1: by No PO -->
                <Border Grid.Column="0" CornerRadius="12" Background="#FF161F30" BorderBrush="#FF1E293B" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="KOLOM 1 — VIA NO PO"
                                   FontFamily="Bahnschrift Bold"
                                   FontSize="12"
                                   Foreground="#60A5FA" />

                        <TextBlock Text="No PO"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="12"
                                   Foreground="#9AA6B8"
                                   Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PoBox"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Height="36"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     ToolTip="Ketik No PO dari ERP (contoh: PO-0003)" />
                            <Button Grid.Column="1"
                                    x:Name="PoSearchButton"
                                    Content="Cari"
                                    Click="PoSearch_Click"
                                    Style="{StaticResource RoundedActionButtonStyle}"
                                    Width="66"
                                    Height="36"
                                    Margin="6,0,0,0" />
                        </Grid>

                        <TextBlock Text="PILIH KODE UNIT EST"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="11"
                                   Foreground="#9AA6B8"
                                   Margin="0,14,0,4" />
                        <ComboBox x:Name="PoUnitCombo"
                                  Height="210"
                                  FontSize="13"
                                  ToolTip="Unit yang tersedia untuk No PO di atas">
                        </ComboBox>

                        <TextBlock x:Name="PoStatusText"
                                   Foreground="#8C97AB"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <Button x:Name="PoConnectButton"
                                Content="Hubungkan Unit Ini"
                                Click="ConnectByPo_Click"
                                Style="{StaticResource BigPrimaryButtonStyle}"
                                Height="40"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Border>
                <!-- Divider -->
                <Border Grid.Column="1" Width="1" Background="#FF1E293B" Margin="18,4" />

                <!-- COLUMN 2: by Kode Unit -->
                <Border Grid.Column="2" CornerRadius="12" Background="#FF161F30" BorderBrush="#FF1E293B" BorderThickness="1" Padding="16">
                    <StackPanel>
                        <TextBlock Text="KOLOM 2 — VIA KODE UNIT"
                                   FontFamily="Bahnschrift Bold"
                                   FontSize="12"
                                   Foreground="#60A5FA" />

                        <TextBlock Text="Kode Unit Kanban ERP"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="12"
                                   Foreground="#9AA6B8"
                                   Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="UnitCodeBox"
                                     Style="{StaticResource SearchTextBoxStyle}"
                                     Height="36"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     ToolTip="Ketik Kode Unit (internalId) atau Pra-QC code / serial (contoh: EST-2610-0003-01)" />
                            <Button Grid.Column="1"
                                    x:Name="UnitSearchButton"
                                    Content="Cari"
                                    Click="UnitSearch_Click"
                                    Style="{StaticResource RoundedActionButtonStyle}"
                                    Width="66"
                                    Height="36"
                                    Margin="6,0,0,0" />
                        </Grid>

                        <TextBlock Text="HASIL PENCARIAN"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="11"
                                   Foreground="#9AA6B8"
                                   Margin="0,14,0,4" />
                        <Border CornerRadius="8" Background="#FF0B0F17" BorderBrush="#FF1E293B" BorderThickness="1" Height="210" Padding="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="UnitDetailText"
                                           Foreground="#D5DCE8"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Text="Belum ada unit yang dicari." />
                            </ScrollViewer>
                        </Border>

                        <TextBlock x:Name="UnitStatusText"
                                   Foreground="#8C97AB"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0" />

                        <Button x:Name="UnitConnectButton"
                                Content="Hubungkan Kode Unit"
                                Click="ConnectByUnit_Click"
                                Style="{StaticResource BigPrimaryButtonStyle}"
                                Height="40"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Stretch"
                                IsEnabled="False" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Tester:"
                               Foreground="#9AA6B8"
                               FontSize="12"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="TesterCombo"
                              Width="170"
                              Height="34"
                              FontSize="12"
                              DisplayMemberPath="Name"
                              ToolTip="Pilih tester QC yang terdaftar di hub" />
                    <TextBox x:Name="NewTesterBox"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Width="120"
                             Height="34"
                             Margin="6,0,0,0"
                             FontSize="12"
                             VerticalContentAlignment="Center"
                             Padding="6,0"
                             ToolTip="Atau ketik nama tester baru" />
                    <Button x:Name="AddTesterButton"
                            Content="Tester+"
                            Click="AddTester_Click"
                            Style="{StaticResource RoundedActionButtonStyle}"
                            Height="34"
                            Margin="6,0,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="FooterStatusText"
                           Foreground="#8C97AB"
                           FontSize="11"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="14,0,14,0" />

                <Button Grid.Column="2"
                        Content="Lanjut Tanpa ERP"
                        Click="Skip_Click"
                        Style="{StaticResource RoundedActionButtonStyle}"
                        Width="150"
                        Height="38"
                        VerticalAlignment="Center"
                        ToolTip="Masuk ke Quality Control tanpa menghubungkan ke kanban ERP" />
            </Grid>
        </Grid>
    </Border>
</Window>
