<Window x:Class="RyotaQC.App.Views.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update RyotaQC V5"
        Width="540" Height="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#0F1729"
        Foreground="#E5E7EB"
        Closing="Window_Closing">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                        Foreground="#FBBF24" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel>
                <TextBlock Text="Update Wajib Tersedia!" FontSize="20" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                <TextBlock x:Name="VersionText" Text="v0.0.0" FontSize="13" Foreground="#94A3B8"/>
            </StackPanel>
        </StackPanel>

        <!-- MANDATORY WARNING BANNER -->
        <Border Grid.Row="1" Background="#3A1F0826" CornerRadius="6" Padding="14,10" Margin="0,0,0,12"
                BorderBrush="#9A7C1E" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#FBBF24"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="Update ini wajib diinstal. Aplikasi tidak dapat digunakan sampai update selesai."
                           Foreground="#FCD34D" FontSize="12" TextWrapping="Wrap" MaxWidth="440"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- CURRENT VS NEW VERSION -->
        <Border Grid.Row="2" Background="#16244B" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Versi sekarang: " Foreground="#94A3B8" FontSize="12"/>
                <TextBlock x:Name="CurrentVersionText" Text="v0.0.0" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="    →    " Foreground="#475569" FontSize="12"/>
                <TextBlock Text="Versi baru: " Foreground="#94A3B8" FontSize="12"/>
                <TextBlock x:Name="NewVersionText" Text="v0.0.0" Foreground="#34D399" FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- RELEASE NOTES -->
        <Border Grid.Row="3" Background="#1E293B" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="DateText" Text="Tanggal rilis: -"
                               Foreground="#64748B" FontSize="11" Margin="0,0,0,8"/>
                    <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="12"
                               Foreground="#CBD5E1" LineHeight="18"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- PROGRESS -->
        <StackPanel Grid.Row="4" x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,12">
            <TextBlock x:Name="ProgressText" Text="Mengunduh update... 0%"
                        Foreground="#94A3B8" FontSize="12" Margin="0,0,0,6"/>
            <ProgressBar x:Name="DownloadProgress" Minimum="0" Maximum="100" Value="0"
                         Height="6" Foreground="#34D399" Background="#1E293B"/>
        </StackPanel>

        <!-- BUTTONS (only Update button — mandatory) -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="UpdateButton" Content="Update Sekarang" Width="220" Height="38"
                    Background="#0EA5E9" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" FontSize="14" Click="UpdateButton_Click"/>
        </StackPanel>
    </Grid>
</Window>