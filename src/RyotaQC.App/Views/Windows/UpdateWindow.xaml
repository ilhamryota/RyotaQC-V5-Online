<Window x:Class="RyotaQC.App.Views.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update RyotaQC"
        Width="700"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="Segoe UI">

    <Window.Resources>
        <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#121E32" Offset="0" />
            <GradientStop Color="#0D1628" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#338FFF" Offset="0" />
            <GradientStop Color="#1260D9" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1976F5" Offset="0" />
            <GradientStop Color="#328CFF" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Background="{StaticResource PrimaryBrush}"
                                Padding="18,14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#C9D5E8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Background="#16203380"
                                BorderBrush="#2B3C5B"
                                BorderThickness="1"
                                Padding="18,14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A2942" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedProgressStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="9" />
            <Setter Property="Background" Value="#263958" />
            <Setter Property="Foreground" Value="#2A8CFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <Grid x:Name="PART_Track">
                                <Rectangle x:Name="PART_Indicator"
                                           HorizontalAlignment="Left"
                                           Fill="{TemplateBinding Foreground}"
                                           RadiusX="5"
                                           RadiusY="5" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20"
            Background="{StaticResource PanelBrush}"
            BorderBrush="#2B3C5B"
            BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="62" Height="62" CornerRadius="31" Background="{StaticResource LogoBrush}">
                    <TextBlock Text="&#xE895;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="28"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="Update Tersedia!"
                               Foreground="#F4F7FF"
                               FontFamily="Bahnschrift SemiBold"
                               FontSize="25"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText"
                               Text="Versi terbaru RyotaQC V5"
                               Foreground="#9EAFCa"
                               FontSize="14"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="CloseButton"
                        Click="CloseButton_Click"
                        Content="&#x2715;"
                        FontSize="18"
                        Width="34"
                        Height="34"
                        VerticalAlignment="Top"
                        Cursor="Hand"
                        Foreground="#AAB8CE"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Nanti" />
            </Grid>

            <!-- ===== Notice ===== -->
            <Border Grid.Row="1" Margin="0,24,0,0" CornerRadius="13" Background="#14294A" BorderBrush="#2759A0" BorderThickness="1" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="#54A0FF"
                               VerticalAlignment="Top"
                               Margin="0,2,12,0" />
                    <TextBlock Grid.Column="1"
                               x:Name="NoticeText"
                               Foreground="#DCE9FF"
                               FontSize="13"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Text="Update ini bisa dipasang sekarang atau nanti." />
                </Grid>
            </Border>

            <!-- ===== Version cards ===== -->
            <Border Grid.Row="2" Margin="0,18,0,0" CornerRadius="14" Background="#17243A" BorderBrush="#263653" BorderThickness="1" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Versi Sekarang" Foreground="#9EAFCa" FontSize="13" />
                        <TextBlock x:Name="CurrentVersionText"
                                   Text="v5.0.7"
                                   Foreground="#F4F7FF"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="21"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <Border Grid.Column="1" Width="1" Background="#354663" Margin="20,2" />

                    <StackPanel Grid.Column="2" Margin="20,0,0,0">
                        <TextBlock Text="Versi Terbaru" Foreground="#9EAFCa" FontSize="13" />
                        <TextBlock x:Name="NewVersionText"
                                   Text="v5.0.8"
                                   Foreground="#3995FF"
                                   FontFamily="Bahnschrift SemiBold"
                                   FontSize="21"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Changelog ===== -->
            <StackPanel Grid.Row="3" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8FD;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#F4F7FF"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Text="Detail Perubahan"
                               Foreground="#F4F7FF"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Border Margin="0,10,0,0" CornerRadius="13" Background="#17243A" BorderBrush="#263653" BorderThickness="1" Padding="16,12">
                    <ScrollViewer MaxHeight="126" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="NotesText"
                                   Foreground="#C4D0E5"
                                   FontSize="13"
                                   LineHeight="22"
                                   TextWrapping="Wrap"
                                   Text="• Peningkatan stabilitas sistem." />
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- ===== Progress ===== -->
            <StackPanel Grid.Row="4" x:Name="ProgressPanel" Margin="0,20,0,0">
                <Grid Margin="0,0,0,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE895;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="#3895FF"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1"
                               x:Name="DownloadLabel"
                               Text="Siap mengunduh update"
                               Foreground="#9EAFCa"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2"
                               x:Name="PercentText"
                               Text="0%"
                               Foreground="#F4F7FF"
                               FontSize="13"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Grid>

                <ProgressBar x:Name="DownloadProgress"
                             Style="{StaticResource RoundedProgressStyle}"
                             Minimum="0"
                             Maximum="100"
                             Value="0" />
            </StackPanel>

            <!-- ===== Actions ===== -->
            <Grid Grid.Row="5" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        x:Name="UpdateButton"
                        Content="Update Sekarang"
                        Click="UpdateButton_Click"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <Button Grid.Column="1"
                        x:Name="LaterButton"
                        Content="Nanti"
                        Click="LaterButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120"
                        Margin="12,0,0,0"
                        Visibility="Collapsed" />
            </Grid>

            <!-- ===== Status ===== -->
            <TextBlock Grid.Row="6"
                       x:Name="StatusText"
                       Text="Pastikan koneksi internet stabil sebelum update."
                       Foreground="#8494AD"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0" />
        </Grid>
    </Border>
</Window>
