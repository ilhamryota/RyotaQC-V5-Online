<Window x:Class="RyotaQC.App.Views.Windows.QcDualBatteryPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Battery Health"
        Width="440"
        Height="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1425"
        AllowsTransparency="True"
        ShowInTaskbar="False">
    <Border CornerRadius="16" Background="#E60F1425" BorderBrush="#556FA7FF" BorderThickness="1.5" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="#33263A5E" BorderBrush="#554CA7FF" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="&#xE83F;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#4CA7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Text="Battery Health"
                           Foreground="#F6F8FF"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       x:Name="QuestionText"
                       Text="Masukkan nilai Battery Health dari battery report:"
                       Foreground="#AEB7CA"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,16,0,0" />

            <!-- Battery 1 (mandatory) -->
            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                <TextBlock Text="BATTERY HEALTH 1 (WAJIB)"
                           FontFamily="Bahnschrift SemiBold"
                           FontSize="11"
                           Foreground="#39C86B" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox x:Name="Health1Box"
                             Width="120" Height="44"
                             FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                             Foreground="#F6F8FF" Background="#22182C44"
                             BorderBrush="#5539C86B" BorderThickness="1.5"
                             Padding="8,4"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             CaretBrush="#4CA7FF"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             MaxLength="3" />
                    <TextBlock Text="%" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#AEB7CA" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Battery 2 (optional) -->
            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock Text="BATTERY HEALTH 2 (OPSIONAL — JIKA ADA 2 BATTERY)"
                           FontFamily="Bahnschrift SemiBold"
                           FontSize="11"
                           Foreground="#F0A020" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBox x:Name="Health2Box"
                             Width="120" Height="44"
                             FontFamily="Segoe UI" FontSize="20" FontWeight="Bold"
                             Foreground="#F6F8FF" Background="#22182C44"
                             BorderBrush="#55F0A020" BorderThickness="1.5"
                             Padding="8,4"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center"
                             CaretBrush="#4CA7FF"
                             PreviewTextInput="NumberOnly_PreviewTextInput"
                             MaxLength="3" />
                    <TextBlock Text="%" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="#AEB7CA" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </StackPanel>

            <TextBlock Grid.Row="4"
                       x:Name="HintText"
                       Text="Health 1 wajib diisi. Health 2 hanya jika unit memiliki 2 battery."
                       Foreground="#8C97AB"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Width="100" Height="40" Content="Batal" Margin="0,0,12,0" Click="Cancel_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CancelB" CornerRadius="10" Background="#44444444" BorderBrush="#66FFFFFF" BorderThickness="1.2">
                                <TextBlock Text="Batal" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CancelB" Property="Background" Value="#55555555" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Width="110" Height="40" Content="Submit" Click="Submit_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="SubmitB" CornerRadius="10" Background="#FF1E7A4B" BorderBrush="#5539C86B" BorderThickness="1.2">
                                <TextBlock Text="Submit" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="SubmitB" Property="Background" Value="#FF248A57" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
