<Window x:Class="RyotaQC.App.Views.Windows.QcYesNoPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pertanyaan"
        Width="470"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1425"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Focusable="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border CornerRadius="16" Background="#E60F1425" BorderBrush="#556FA7FF" BorderThickness="1.5" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="#33263A5E" BorderBrush="#554CA7FF" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D9;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#4CA7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Text="Pertanyaan"
                           Foreground="#F6F8FF"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1"
                       x:Name="MessageText"
                       Text="Apakah unit ini memiliki Touchscreen?"
                       Foreground="#AEB7CA"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       TextWrapping="Wrap"
                       Margin="0,18,0,0" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button x:Name="YesButton" Width="150" Height="52" Margin="0,0,12,0" Click="Yes_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="YesBorder" CornerRadius="12" Background="#FF1E7A4B" BorderBrush="#5539C86B" BorderThickness="1.5">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                                    <TextBlock Text="Enter" FontFamily="Segoe UI" FontSize="10" Foreground="#CFF7E2" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="YesBorder" Property="Background" Value="#FF248A57" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="NoButton" Width="150" Height="52" Click="No_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="NoBorder" CornerRadius="12" Background="#44444444" BorderBrush="#66FFFFFF" BorderThickness="1.5">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe UI" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Esc" FontFamily="Segoe UI" FontSize="10" Foreground="#E2E8F0" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="NoBorder" Property="Background" Value="#55555555" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
