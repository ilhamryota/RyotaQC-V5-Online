<Window x:Class="RyotaQC.App.Views.Windows.QcHealthVerdictPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hasil Health"
        Width="460"
        Height="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1425"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Focusable="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border CornerRadius="16" Background="#E60F1425" BorderBrush="#556FA7FF" BorderThickness="1.5" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="#33263A5E" BorderBrush="#554CA7FF" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock Text="&#xE9D9;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#4CA7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Text="Hasil Health"
                           Foreground="#F6F8FF"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="10" Background="#FF0B0F17" BorderBrush="#FF1E293B" BorderThickness="1" Padding="14,12" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock x:Name="ValueText"
                               Text="0%"
                               FontFamily="Bahnschrift Bold"
                               FontSize="30"
                               Foreground="#F6F8FF"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="VerdictHintText"
                               Text="70% - 100% = Pass · di bawah 70% = Fail"
                               FontFamily="Segoe UI"
                               FontSize="11"
                               Foreground="#8C97AB"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="Space = OK   ·   - (minus) = Optional   ·   Esc = Fail"
                       Foreground="#AEB7CA"
                       FontFamily="Segoe UI"
                       FontSize="11.5"
                       TextAlignment="Center"
                       Margin="0,16,0,0" />

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                <!-- OK / Pass -->
                <Button Width="120" Height="52" Margin="0,0,12,0" Click="Ok_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="OkBorder" CornerRadius="12" Background="#FF1E7A4B" BorderBrush="#5539C86B" BorderThickness="1.5">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                                    <TextBlock Text="OK" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="Space" FontFamily="Segoe UI" FontSize="10" Foreground="#CFF7E2" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OkBorder" Property="Background" Value="#FF248A57" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- - Optional -->
                <Button Width="120" Height="52" Margin="0,0,12,0" Click="Optional_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="OptBorder" CornerRadius="12" Background="#44444444" BorderBrush="#66FFFFFF" BorderThickness="1.5">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Optional" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="-" FontFamily="Segoe UI" FontSize="10" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OptBorder" Property="Background" Value="#55555555" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- X Fail -->
                <Button Width="120" Height="52" Click="Fail_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="FailBorder" CornerRadius="12" Background="#FFB91C1C" BorderBrush="#55FF4444" BorderThickness="1.5">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White" HorizontalAlignment="Center" />
                                    <TextBlock Text="Fail" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    <TextBlock Text="Esc" FontFamily="Segoe UI" FontSize="10" Foreground="#FFD6D6" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="FailBorder" Property="Background" Value="#FFD22222" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
