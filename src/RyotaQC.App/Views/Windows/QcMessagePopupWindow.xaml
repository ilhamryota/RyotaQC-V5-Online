<Window x:Class="RyotaQC.App.Views.Windows.QcMessagePopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RyotaQC V5"
        Width="520"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1425"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Focusable="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="AccentBorder"
            CornerRadius="16"
            Background="#E60F1425"
            BorderBrush="#556FA7FF"
            BorderThickness="1.5"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border x:Name="IconBorder"
                        Width="36" Height="36" CornerRadius="10"
                        Background="#33263A5E" BorderBrush="#554CA7FF" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="IconText"
                               Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#4CA7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="TitleText"
                           Text="Informasi"
                           Foreground="#F6F8FF"
                           FontFamily="Segoe UI"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer Grid.Row="1"
                          MaxHeight="320"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,16,0,0">
                <TextBlock x:Name="MessageText"
                           Text=""
                           Foreground="#C3CCDB"
                           FontFamily="Segoe UI"
                           FontSize="14"
                           LineHeight="21"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <Button Grid.Row="2"
                    Width="140"
                    Height="44"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0"
                    Click="Ok_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#FF1D2942" BorderBrush="#FF2B3C5B" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="OK" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="  ·  Enter" FontFamily="Segoe UI" FontSize="10" Foreground="#A9B7CC" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF24344F" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
