<Window x:Class="RyotaQC.App.Views.Windows.QcHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Hasil QC"
        Width="620"
        SizeToContent="Height"
        MaxHeight="720"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0F1425"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Focusable="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="AccentBorder"
            CornerRadius="16"
            Background="#E60F1425"
            BorderBrush="#556FA7FF"
            BorderThickness="1.5"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10"
                        Background="#33263A5E" BorderBrush="#554CA7FF" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE81C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Foreground="#4CA7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Log Hasil QC"
                               Foreground="#F6F8FF"
                               FontFamily="Segoe UI"
                               FontSize="20"
                               FontWeight="Bold" />
                    <TextBlock x:Name="UnitText"
                               Text=""
                               Foreground="#8E9DB5"
                               FontFamily="Segoe UI"
                               FontSize="12" />
                </StackPanel>
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="0,14,0,10"
                    CornerRadius="8"
                    Background="#22152033"
                    BorderBrush="#332E4A78"
                    BorderThickness="1"
                    Padding="12,8">
                <TextBlock x:Name="SummaryText"
                           Text=""
                           Foreground="#A9B7CC"
                           FontFamily="Segoe UI"
                           FontSize="12" />
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="HistoryList" />
            </ScrollViewer>

            <Button Grid.Row="3"
                    Width="140"
                    Height="44"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0"
                    Click="Close_Click"
                    Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#FF1D2942" BorderBrush="#FF2B3C5B" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Tutup" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="  ·  Esc" FontFamily="Segoe UI" FontSize="10" Foreground="#A9B7CC" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF24344F" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3B82F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
