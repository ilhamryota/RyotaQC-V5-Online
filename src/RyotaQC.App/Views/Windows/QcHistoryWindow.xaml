<Window x:Class="RyotaQC.App.Views.Windows.QcHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log Hasil QC"
        Width="780"
        Height="720"
        MinHeight="600"
        MaxHeight="860"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="#0F1425"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Focusable="True"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border x:Name="AccentBorder"
            CornerRadius="16"
            Background="#E60F1425"
            BorderBrush="#556FA7FF"
            BorderThickness="1.5"
            Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                        Background="#33263A5E" BorderBrush="#554CA7FF" BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE81C;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="#4CA7FF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Log Hasil QC"
                                   Foreground="#F6F8FF"
                                   FontFamily="Segoe UI"
                                   FontSize="20"
                                   FontWeight="Bold" />
                        <Border x:Name="StatusBadge"
                                CornerRadius="6"
                                Background="#3322C55E"
                                Padding="8,2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock x:Name="StatusBadgeText"
                                       Text="PASS"
                                       Foreground="#86EFAC"
                                       FontFamily="Segoe UI"
                                       FontSize="11"
                                       FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock x:Name="UnitText"
                                   Text="Unit: -"
                                   Foreground="#8E9DB5"
                                   FontFamily="Segoe UI"
                                   FontSize="12" />
                        <TextBlock x:Name="DestinationText"
                                   Text=""
                                   Foreground="#60A5FA"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Close X button in top right -->
                <Button Grid.Column="2"
                        Width="32"
                        Height="32"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Close_Click">
                    <TextBlock Text="&#xE8BB;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               Foreground="#8E9DB5"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- Main Content ScrollViewer -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0">
                <StackPanel>
                    <!-- CARD 1: Identitas & Spesifikasi Hardware -->
                    <Border CornerRadius="10"
                            Background="#18132238"
                            BorderBrush="#333B82F6"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE7F8;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="#60A5FA"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="IDENTITAS &amp; SPESIFIKASI HARDWARE"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#93C5FD" />
                            </StackPanel>

                            <Grid x:Name="HardwareSpecsGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Column 1 -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,2,0,4">
                                    <TextBlock Text="Merk / Brand" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="BrandText" Text="-" Foreground="#E1E7F0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,4,0,4">
                                    <TextBlock Text="Tipe Laptop" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="ModelText" Text="-" Foreground="#E1E7F0" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,4,0,4">
                                    <TextBlock Text="Serial Number" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="SnText" Text="-" Foreground="#60A5FA" FontSize="13" FontWeight="Bold" FontFamily="Consolas" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,4,0,4">
                                    <TextBlock Text="Prosesor (CPU)" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="CpuText" Text="-" Foreground="#E1E7F0" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,4,0,2">
                                    <TextBlock Text="RAM" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="RamText" Text="-" Foreground="#E1E7F0" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Column 2 -->
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,2,0,4">
                                    <TextBlock Text="Storage SSD" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="SsdText" Text="-" Foreground="#E1E7F0" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,4,0,4">
                                    <TextBlock Text="Storage HDD" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="HddText" Text="-" Foreground="#E1E7F0" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,4,0,4">
                                    <TextBlock Text="VGA / Grafis" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="VgaText" Text="-" Foreground="#E1E7F0" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,4,0,4">
                                    <TextBlock Text="Layar (LCD / Display)" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="DisplayText" Text="-" Foreground="#E1E7F0" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,4,0,2">
                                    <TextBlock Text="Kondisi Fisik" Foreground="#6E7C94" FontSize="11" />
                                    <TextBlock x:Name="PhysicalText" Text="-" Foreground="#34D399" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CARD 2: Pengujian Fungsi QC & Running Test -->
                    <Border CornerRadius="10"
                            Background="#18132238"
                            BorderBrush="#333B82F6"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="#34D399"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="HASIL PENGUJIAN FUNGSI &amp; RUNNING TEST"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#86EFAC" />
                            </StackPanel>

                            <WrapPanel x:Name="FunctionTestsPanel" Margin="-4" />
                        </StackPanel>
                    </Border>

                    <!-- CARD 3: Catatan QC Kanban -->
                    <Border CornerRadius="10"
                            Background="#18132238"
                            BorderBrush="#333B82F6"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE70F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="#FBBF24"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Text="CATATAN KANBAN QC"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#FDE68A" />
                            </StackPanel>
                            <TextBlock x:Name="NotesText"
                                       Text="Tidak ada catatan tambahan untuk unit ini."
                                       Foreground="#CBD5E1"
                                       FontFamily="Segoe UI"
                                       FontSize="12.5"
                                       TextWrapping="Wrap"
                                       LineHeight="18" />
                        </StackPanel>
                    </Border>

                    <!-- CARD 4: Riwayat Log Sebelumnya -->
                    <Border CornerRadius="10"
                            Background="#140E1B2C"
                            BorderBrush="#223B82F6"
                            BorderThickness="1"
                            Padding="14"
                            Margin="0,0,0,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#xE823;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Foreground="#A5B4FC"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock x:Name="HistoryHeaderTitle"
                                           Text="RIWAYAT LOG QC SEBELUMNYA (MAKS 7)"
                                           FontFamily="Segoe UI"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#C7D2FE" />
                            </StackPanel>
                            <StackPanel x:Name="HistoryList" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2" Margin="0,14,0,0">
                <TextBlock x:Name="SummaryText"
                           Text=""
                           Foreground="#8E9DB5"
                           FontFamily="Segoe UI"
                           FontSize="11.5"
                           VerticalAlignment="Center" />

                <Button Width="130"
                        Height="40"
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="8" Background="#FF1E293B" BorderBrush="#FF334155" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="Tutup" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="White" />
                                    <TextBlock Text="  ·  Esc" FontFamily="Segoe UI" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF2563EB" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF3B82F6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>