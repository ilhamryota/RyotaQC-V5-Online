<Page x:Class="RyotaQC.App.Views.Pages.QualityControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="Transparent">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="QcChecklistRowStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="#FF131B2E" />
            <Setter Property="BorderBrush" Value="#FF1E293B" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="QcCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{StaticResource SelectedFocusVisualStyle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiBold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>

        <Style x:Key="QcStatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF1E293B" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#FF334155" />
        </Style>
    </Page.Resources>

    <Page.Triggers>
        <EventTrigger RoutedEvent="Page.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="QcLeftPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.30">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="QcLeftPanel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="18" To="0"
                                     Duration="0:0:0.34">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="QcRightPanel"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1"
                                     Duration="0:0:0.30"
                                     BeginTime="0:0:0.06">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="QcRightPanel"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                     From="18" To="0"
                                     Duration="0:0:0.34"
                                     BeginTime="0:0:0.06">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid Margin="20,0,20,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="QcLeftPanel"
                Grid.Column="0"
                Style="{StaticResource Ps5GlassCardStyle}"
                Margin="0,0,10,0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Button Command="{Binding BackToHomeCommand}"
                            Style="{StaticResource BackIconButtonStyle}"
                            ToolTip="Kembali ke Main Menu"
                            HorizontalAlignment="Left" />

                    <TextBlock Text="Quality Control"
                               Style="{StaticResource SectionHeaderTextStyle}"
                               FontSize="20"
                               Margin="0,8,0,0" />

                    <TextBlock Text="CATATAN OTOMATIS"
                               Margin="0,12,0,4"
                               FontFamily="Bahnschrift SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" />

                    <TextBox Text="{Binding ChecklistSummary}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Height="130"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             FontSize="13"
                             Margin="0" />

                    <Button Content="Hasil QC"
                            Command="{Binding ShowOverallQcResultsCommand}"
                            Style="{StaticResource RoundedActionButtonStyle}"
                            Width="120"
                            Height="34"
                            Margin="0,10,0,6"
                            HorizontalAlignment="Left" />

                    <!-- Integrasi EsteraOne ERP Twenty UI -->
                    <Border CornerRadius="8" Background="#FF161F30" BorderBrush="#FF1E293B" BorderThickness="1" Padding="14" Margin="0,10,0,10">
                        <StackPanel>
                            <TextBlock Text="ESTERAONE ERP SYNC"
                                       FontFamily="Bahnschrift Bold"
                                       FontSize="11"
                                       Foreground="#FF60A5FA"
                                       Margin="0,0,0,6" />
                            
                            <TextBlock Text="No PO"
                                       FontFamily="Bahnschrift SemiBold"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,4" />
                            
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding PoNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         Height="34"
                                         FontSize="13"
                                         VerticalContentAlignment="Center"
                                         Padding="8,0"
                                         ToolTip="Ketik No PO dari ERP (e.g. PO-0003)" />
                                <Button Grid.Column="1"
                                        Content="Cari"
                                        Command="{Binding LookupPoUnitsCommand}"
                                        Style="{StaticResource RoundedActionButtonStyle}"
                                        Width="60"
                                        Height="34"
                                        Margin="6,0,0,0"
                                        ToolTip="Cari unit-unit pada PO ini" />
                            </Grid>

                            <!-- Daftar EST codes (po units) -->
                            <StackPanel Visibility="{Binding HasPoUnits, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Margin="0,4,0,8">
                                <TextBlock Text="PILIH KODE UNIT (EST)"
                                           FontFamily="Bahnschrift SemiBold"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding PoUnits}"
                                           SelectedItem="{Binding SelectedUnit, Mode=TwoWay}"
                                           Height="34"
                                           FontSize="13"
                                           ToolTip="Pilih unit (Lenovo diprioritaskan di atas)">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding InternalId}" FontWeight="SemiBold" />
                                                <TextBlock Text=" — " />
                                                <TextBlock Text="{Binding Brand}" Foreground="#FF60A5FA" />
                                                <TextBlock Text=" / " />
                                                <TextBlock Text="{Binding ProductName}" Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Tester + Hubungkan -->
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0"
                                           ItemsSource="{Binding Testers}"
                                           SelectedItem="{Binding SelectedTester, Mode=TwoWay}"
                                           Height="34"
                                           FontSize="13"
                                           ToolTip="Pilih tester QC (atau daftar baru)">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="1"
                                        Content="Tester+"
                                        Command="{Binding RegisterTesterCommand}"
                                        Style="{StaticResource RoundedActionButtonStyle}"
                                        Height="34"
                                        Margin="6,0,0,0"
                                        ToolTip="Daftarkan tester baru (isi nama di sebelah kanan)" />
                                <TextBox Grid.Column="2"
                                         Text="{Binding TesterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource SearchTextBoxStyle}"
                                         Width="120"
                                         Height="34"
                                         Margin="6,0,0,0"
                                         FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Padding="6,0"
                                         ToolTip="Nama tester baru" />
                            </Grid>

                            <Button Content="Hubungkan"
                                    Command="{Binding ConnectCommand}"
                                    Style="{StaticResource BigPrimaryButtonStyle}"
                                    Height="36"
                                    Margin="0,4,0,8"
                                    HorizontalAlignment="Stretch"
                                    ToolTip="Ikat app ini ke unit EST terpilih (tester wajib dipilih)" />

                            <Border CornerRadius="6" Background="#FF0B0F17" BorderBrush="#FF1E293B" BorderThickness="1" Padding="8,6" Margin="0,0,0,8"
                                    Visibility="{Binding HasErpUnitDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding ErpUnitDetails}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Status dropdown -->
                            <TextBlock Text="STATUS QC"
                                       FontFamily="Bahnschrift SemiBold"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,4" />
                            <ComboBox ItemsSource="{Binding QcStatusOptions}"
                                       SelectedItem="{Binding QcStatus, Mode=TwoWay}"
                                       Height="34"
                                       FontSize="13"
                                       Margin="0,0,0,8"
                                       ToolTip="Pilih status akhir QC (LULUS=Selesai, SERVICE=Servis, RETUR=Retur, RUNNING_TEST=Tes Running)" />

                            <Button Content="Kirim ke ERP"
                                    Command="{Binding SyncToErpCommand}"
                                    Style="{StaticResource BigPrimaryButtonStyle}"
                                    Height="38"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Stretch"
                                    ToolTip="Kirim spek + hasil QC ke ERP dan pindahkan Kanban unit" />

                            <TextBlock Text="{Binding ErpSyncStatus}"
                                       FontSize="11"
                                       Foreground="{Binding ErpSyncStatusColorBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="QcRightPanel"
                Grid.Column="1"
                Style="{StaticResource QcPanelCardStyle}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TranslateTransform />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="Pemeriksaan Hardware &amp; Pengujian"
                           Style="{StaticResource CardTitleTextStyle}"
                           FontSize="20"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="Bahnschrift SemiBold"
                           Margin="0,0,0,10" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Refresh List"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource RoundedActionButtonStyle}"
                                    Width="100"
                                    Height="32" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DisplayChecklistItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource QcChecklistRowStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                          Style="{StaticResource QcCheckBoxStyle}" />
                                                <Image Source="{Binding IconPath}" Width="20" Height="20"
                                                       Margin="0,0,10,0"
                                                       Stretch="Uniform" />
                                                <TextBlock Text="{Binding Name}" FontFamily="Bahnschrift SemiBold" FontSize="15"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Run"
                                                    Command="{Binding RunCommand}"
                                                    Style="{StaticResource RoundedActionButtonStyle}"
                                                    Width="72"
                                                    Height="30"
                                                    Margin="0,0,8,0" />

                                            <!-- Color-coded result box (OK/-/X) -->
                                            <Border Grid.Column="2" Width="56" Height="28" CornerRadius="6"
                                                    Margin="0,0,8,0"
                                                    BorderThickness="1"
                                                    BorderBrush="#44FFFFFF"
                                                    Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{Binding ResultColor}" />
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding ResultLabel}"
                                                           FontFamily="Bahnschrift SemiBold"
                                                           FontSize="12" FontWeight="Bold" Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>

                                            <TextBlock Grid.Row="1"
                                                       Grid.ColumnSpan="3"
                                                       Text="{Binding InfoText}"
                                                       Margin="0,4,0,0"
                                                       FontFamily="Bahnschrift"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border CornerRadius="8" Background="#FF131B2E" BorderBrush="#FF1E293B" BorderThickness="1" Padding="12"
                                Margin="0,2,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding BenchmarkChecklistItem.IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0"
                                              Width="20"
                                              Height="20" />
                                    <Image Source="Assets/Images/Icons/QC/benchmark.png"
                                           Width="24"
                                           Height="24"
                                           Margin="0,0,8,0" />
                                    <TextBlock Text="Benchmark"
                                               FontFamily="Bahnschrift SemiBold"
                                               FontSize="19"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                </StackPanel>

                                <ComboBox ItemsSource="{Binding BenchmarkOptions}"
                                          SelectedItem="{Binding SelectedBenchmark, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          FontFamily="Bahnschrift SemiBold"
                                          FontSize="16"
                                          Height="36"
                                          Margin="0,8,0,0"
                                          Foreground="Black"
                                          Background="White"
                                          BorderBrush="#556F9BFF">
                                    <ComboBox.Resources>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="FontFamily" Value="Bahnschrift SemiBold" />
                                            <Setter Property="FontSize" Value="14" />
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Install / Run"
                                            Command="{Binding InstallBenchmarkCommand}"
                                            Style="{StaticResource RoundedActionButtonStyle}"
                                            Width="120"
                                            Height="34" />

                                    <Button Content="Uninstall"
                                            Command="{Binding RemoveBenchmarkCommand}"
                                            Style="{StaticResource RoundedActionButtonStyle}"
                                            Width="100"
                                            Height="34" />

                                    <Button Content="Status"
                                            Command="{Binding ShowQcResultsCommand}"
                                            Style="{StaticResource RoundedActionButtonStyle}"
                                            Width="100"
                                            Height="34"
                                            Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock Text="{Binding BenchmarkActionStatus}"
                                           Margin="0,8,0,0"
                                           FontFamily="Bahnschrift"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMutedBrush}" />

                                <Border CornerRadius="6" Background="#FF161F30" BorderBrush="#FF1E293B" BorderThickness="1" Padding="10"
                                        Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding RunningTestChecklistItem.IsChecked, Mode=TwoWay}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Width="20"
                                                      Height="20" />
                                            <Image Source="Assets/Images/Icons/QC/battery-test.png"
                                                   Width="24"
                                                   Height="24"
                                                   Margin="0,0,8,0" />
                                            <TextBlock Text="Running Test"
                                                       FontFamily="Bahnschrift SemiBold"
                                                       FontSize="19"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="Run"
                                                Command="{Binding RunningTestChecklistItem.RunCommand}"
                                                Style="{StaticResource RoundedActionButtonStyle}"
                                                Width="82"
                                                Height="34"
                                                Margin="0,0,8,0" />

                                        <Border Grid.Column="2" Style="{StaticResource QcStatusBadgeStyle}">
                                            <TextBlock Text="{Binding RunningTestChecklistItem.StatusText}"
                                                       FontFamily="Bahnschrift SemiBold"
                                                       FontSize="15"
                                                       Foreground="#FFDCEBFF" />
                                        </Border>

                                        <TextBlock Grid.Row="1"
                                                   Grid.ColumnSpan="3"
                                                   Text="{Binding RunningTestChecklistItem.InfoText}"
                                                   Margin="0,7,0,0"
                                                   FontFamily="Bahnschrift"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
